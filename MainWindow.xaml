<Window x:Class="RA2Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RA2Installer"
        xmlns:resx="clr-namespace:RA2Installer.Resources"
        mc:Ignorable="d"
        Title="{x:Static resx:Strings.WindowTitle}" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Icon="Assets/RA2.ico">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BB080B"/>
            <Setter Property="Foreground" Value="#BB080B"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="border"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.56"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="Red"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="LayoutRoot" Width="640" Height="480">
        <!-- 主要区域：动画显示控件（共享） -->
        <Image x:Name="AnimationImage" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,75,0,0" Width="470" local:PageProperties.PageNumbers="1,2,3,4"/>
        
        <!-- 雷达区：动画显示控件（共享） -->
        <Image x:Name="RadarAnimationImage" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="472,0,0,0" Width="168" Height="177" local:PageProperties.PageNumbers="4"/>

        <!-- 雷达区：从Language.dll读取的文本显示区域（共享） -->
        <StackPanel x:Name="RadarTextStackPanel" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="483,39,0,0" Width="154" local:PageProperties.PageNumbers="1,2,3"/>
        
        <!-- 许可证内容显示区域（第二页特有） -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="115,45,0,0" Width="245" Height="245" BorderThickness="1" BorderBrush="#BB080B" Visibility="Collapsed" x:Name="LicenseBorder" local:PageProperties.PageNumbers="2">
            <ScrollViewer x:Name="LicenseScrollViewer" Width="235" Height="230" VerticalScrollBarVisibility="Auto" Padding="5" local:PageProperties.PageNumbers="2">
                <TextBlock x:Name="LicenseTextBlock" Foreground="#BB080B" FontSize="12" TextWrapping="Wrap" Text="{x:Static resx:Strings.LicenseContent}" local:PageProperties.PageNumbers="2"/>
            </ScrollViewer>
        </Border>
        
        <!-- 许可证内容显示区域（第三页特有，无边框） -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="115,45,0,0" Width="245" Height="245" Visibility="Collapsed" x:Name="LicenseStackPanel" local:PageProperties.PageNumbers="3">
            <ScrollViewer x:Name="LicenseScrollViewerPage3" Width="235" Height="230" VerticalScrollBarVisibility="Auto" Padding="5" local:PageProperties.PageNumbers="3">
                <TextBlock x:Name="LicenseTextBlockPage3" Foreground="#BB080B" FontSize="12" TextWrapping="Wrap" local:PageProperties.PageNumbers="3"/>
            </ScrollViewer>
        </StackPanel>
        
        <!-- 同意按钮和文本容器（第二页特有） -->
        <Grid x:Name="AgreeContainer" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="130,295,0,0" Width="210" Visibility="Collapsed" local:PageProperties.PageNumbers="2">
            <!-- 同意按钮（背景图片） -->
            <Image x:Name="AgreeButtonImage" Width="210" MouseLeftButtonUp="AgreeButtonImage_MouseLeftButtonUp"/>

            <!-- 同意条款文本（前景） -->
            <TextBlock x:Name="IAgreeToTheseTermsTextBlock" Foreground="#FFEF84" FontSize="12" Width="130" TextAlignment="Left" Text="{x:Static resx:Strings.IAgreeToTheseTerms}" Margin="75,5,0,0" VerticalAlignment="Top"/>
        </Grid>
        
        <!-- 底部文字显示区域（共享） -->
        <TextBlock x:Name="BottomTextBlock" Foreground="Yellow" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,160,8" TextAlignment="Center" Visibility="Collapsed" local:PageProperties.PageNumbers="1,2,3,4"/>
        
        <!-- 输入框区域（第三页特有） -->
        <StackPanel x:Name="InputFieldsStackPanel" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7,0,0,3" Width="457" Visibility="Collapsed" local:PageProperties.PageNumbers="3">
            <TextBox x:Name="InputField1" Width="120" Height="20" Margin="0" BorderThickness="2,2,1,2" MaxLength="6" PreviewTextInput="InputField_PreviewTextInput" GotFocus="InputField_GotFocus" LostFocus="InputField_LostFocus" TextChanged="InputField_TextChanged" TabIndex="1" local:PageProperties.PageNumbers="3"/>
            <TextBox x:Name="InputField2" Width="120" Height="20" Margin="0" BorderThickness="1,2,1,2" MaxLength="6" PreviewTextInput="InputField_PreviewTextInput" GotFocus="InputField_GotFocus" LostFocus="InputField_LostFocus" TextChanged="InputField_TextChanged" TabIndex="2" local:PageProperties.PageNumbers="3"/>
            <TextBox x:Name="InputField3" Width="120" Height="20" Margin="0" BorderThickness="1,2,1,2" MaxLength="6" PreviewTextInput="InputField_PreviewTextInput" GotFocus="InputField_GotFocus" LostFocus="InputField_LostFocus" TextChanged="InputField_TextChanged" TabIndex="3" local:PageProperties.PageNumbers="3"/>
            <TextBox x:Name="InputField4" Width="97" Height="20" Margin="0" BorderThickness="1,2,2,2" MaxLength="4" PreviewTextInput="InputField_PreviewTextInput" GotFocus="InputField_GotFocus" LostFocus="InputField_LostFocus" TextChanged="InputField_TextChanged" TabIndex="4" local:PageProperties.PageNumbers="3"/>
        </StackPanel>
        
        <!-- 多选框区域（第四页特有） -->
        <StackPanel x:Name="CheckBoxesStackPanel" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,80,0,0" Visibility="Collapsed" local:PageProperties.PageNumbers="4">
            <TextBlock x:Name="CheckBoxesTitleTextBlock" Foreground="Yellow" FontSize="16" Margin="0,0,0,30" local:PageProperties.PageNumbers="4"/>
            <StackPanel Orientation="Horizontal" Margin="10,5,0,20" x:Name="CheckBoxItem1" local:PageProperties.PageNumbers="4">
                <Image x:Name="CheckBox1" Width="18" Height="18" MouseLeftButtonUp="CheckBox_MouseLeftButtonUp" Tag="1" local:PageProperties.PageNumbers="4"/>
                <TextBlock x:Name="CheckBoxText1" Foreground="Yellow" FontSize="16" Margin="5,0,0,0" VerticalAlignment="Center" local:PageProperties.PageNumbers="4"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,5,0,20" x:Name="CheckBoxItem2" local:PageProperties.PageNumbers="4">
                <Image x:Name="CheckBox2" Width="18" Height="18" MouseLeftButtonUp="CheckBox_MouseLeftButtonUp" Tag="2" local:PageProperties.PageNumbers="4"/>
                <TextBlock x:Name="CheckBoxText2" Foreground="Yellow" FontSize="16" Margin="5,0,0,0" VerticalAlignment="Center" local:PageProperties.PageNumbers="4"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,5,0,20" x:Name="CheckBoxItem3" local:PageProperties.PageNumbers="4">
                <Image x:Name="CheckBox3" Width="18" Height="18" MouseLeftButtonUp="CheckBox_MouseLeftButtonUp" Tag="3" local:PageProperties.PageNumbers="4"/>
                <TextBlock x:Name="CheckBoxText3" Foreground="Yellow" FontSize="16" Margin="5,0,0,0" VerticalAlignment="Center" local:PageProperties.PageNumbers="4"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,5,0,20" x:Name="CheckBoxItem4" local:PageProperties.PageNumbers="4">
                <Image x:Name="CheckBox4" Width="18" Height="18" MouseLeftButtonUp="CheckBox_MouseLeftButtonUp" Tag="4" local:PageProperties.PageNumbers="4"/>
                <TextBlock x:Name="CheckBoxText4" Foreground="Yellow" FontSize="16" Margin="5,0,0,0" VerticalAlignment="Center" local:PageProperties.PageNumbers="4"/>
            </StackPanel>
        </StackPanel>

        <!-- 第五页内容区域 -->
        <StackPanel x:Name="Page5ContentStackPanel" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,30,0,0" Visibility="Collapsed" local:PageProperties.PageNumbers="5">
            <!-- 第一行：来自dll ID 124 -->
            <TextBlock x:Name="Page5Line1TextBlock" Foreground="#BB080B" FontSize="16" Margin="0,0,0,15" local:PageProperties.PageNumbers="5"/>
            
            <!-- 第二行：红色边框的文本框，内容来自dll ID 5 -->
            <TextBox x:Name="Page5PathTextBox" Width="400" Height="25" Margin="0,250,0,30"  Background="Transparent" HorizontalContentAlignment="Left" local:PageProperties.PageNumbers="5"/>
        
            <!-- 第三行：左对齐的文案来自dll ID 120，右对齐的文字为358693 K -->
            <Grid x:Name="Page5Line3Grid" Width="400" Height="25" Margin="0,0,0,0" local:PageProperties.PageNumbers="5">
                <TextBlock x:Name="Page5Line3LeftTextBlock" Foreground="#BB080B" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Center" local:PageProperties.PageNumbers="5"/>
                <TextBlock x:Name="Page5Line3RightTextBlock" Foreground="#BB080B" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" Text="358693 K" local:PageProperties.PageNumbers="5"/>
            </Grid>
            
            <!-- 第四行：左对齐的文案来自dll ID 119，右对齐的文字来自第2行内容所在盘符的空余空间 -->
            <Grid x:Name="Page5Line4Grid" Width="400" Height="25" Margin="0,0,0,15" local:PageProperties.PageNumbers="5">
                <TextBlock x:Name="Page5Line4LeftTextBlock" Foreground="#BB080B" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Center" local:PageProperties.PageNumbers="5"/>
                <TextBlock x:Name="Page5Line4RightTextBlock" Foreground="#BB080B" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" local:PageProperties.PageNumbers="5"/>
            </Grid>
        </StackPanel>

        <!-- 第六页内容区域 -->
        <StackPanel x:Name="Page6ContentStackPanel" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Width="400" Margin="30,30,0,0" Visibility="Collapsed" local:PageProperties.PageNumbers="6">
            <!-- 第一行：来自dll ID 123，使用ID 18替换 -->
            <TextBlock x:Name="Page6Line1TextBlock" Foreground="#BB080B" FontSize="16" Margin="0,0,0,240" TextWrapping="Wrap" local:PageProperties.PageNumbers="6"/>
            
            <!-- 第二行：来自dll ID 121 -->
            <TextBlock x:Name="Page6Line2TextBlock" Foreground="#BB080B" FontSize="16" Margin="0,0,0,0" local:PageProperties.PageNumbers="6"/>
            
            <!-- 第三行：红色边框的输入框，宽度400，内容来自dll ID 7 -->
            <TextBox x:Name="Page6InputTextBox" Width="400" Height="25" Margin="0,0,0,15" HorizontalContentAlignment="Left" Background="Transparent" local:PageProperties.PageNumbers="6"/>
        </StackPanel>

        <!-- 第七页内容区域 -->
        <StackPanel x:Name="Page7ContentStackPanel" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,30,0,0" Visibility="Collapsed" local:PageProperties.PageNumbers="7">
            <!-- 第一行：来自dll ID 124 -->
            <TextBlock x:Name="Page7Line1TextBlock" Foreground="#BB080B" FontSize="16" Margin="0,0,0,15" local:PageProperties.PageNumbers="7"/>
            
            <!-- 第二行：红色边框的文本框，内容来自dll ID 5 -->
            <TextBox x:Name="Page7PathTextBox" Width="400" Height="25" Margin="0,250,0,30"  Background="Transparent" HorizontalContentAlignment="Left" local:PageProperties.PageNumbers="7"/>
        
            <!-- 第三行：左对齐的文案来自dll ID 120，右对齐的文字为358693 K -->
            <Grid x:Name="Page7Line3Grid" Width="400" Height="25" Margin="0,0,0,0" local:PageProperties.PageNumbers="7">
                <TextBlock x:Name="Page7Line3LeftTextBlock" Foreground="#BB080B" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Center" local:PageProperties.PageNumbers="7"/>
                <TextBlock x:Name="Page7Line3RightTextBlock" Foreground="#BB080B" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" Text="695 K" local:PageProperties.PageNumbers="7"/>
            </Grid>
            
            <!-- 第四行：左对齐的文案来自dll ID 119，右对齐的文字来自第2行内容所在盘符的空余空间 -->
            <Grid x:Name="Page7Line4Grid" Width="400" Height="25" Margin="0,0,0,15" local:PageProperties.PageNumbers="7">
                <TextBlock x:Name="Page7Line4LeftTextBlock" Foreground="#BB080B" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Center" local:PageProperties.PageNumbers="7"/>
                <TextBlock x:Name="Page7Line4RightTextBlock" Foreground="#BB080B" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" local:PageProperties.PageNumbers="7"/>
            </Grid>
        </StackPanel>

        <!-- 按钮容器（共享） -->
        <StackPanel x:Name="ButtonContainer" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,29" local:PageProperties.PageNumbers="1,2,3,4,5,6,7">
            <!-- 导航按钮（所有页面共用） -->
            <StackPanel x:Name="NavigationButtonsStackPanel" Orientation="Vertical" local:PageProperties.PageNumbers="1,2,3,4,5,6,7">
                <!-- 浏览按钮（第五页特有） -->
                <Button x:Name="BrowseButton" Width="145" Height="42" Margin="0,0,0,0" Click="BrowseButton_Click" local:PageProperties.PageNumbers="5,7">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Image Name="bgImage" Source="Assets/nav_bkg0.jpg" Stretch="Fill"/>
                                <TextBlock Name="BrowseButtonTextBlock" Text="{x:Static resx:Strings.BrowseButton}" Foreground="Yellow" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bgImage" Property="Source" Value="Assets/nav_bkg1.jpg"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BackButton" Width="145" Height="42" Margin="0,0,0,0" Click="BackButton_Click" local:PageProperties.PageNumbers="2,3,4,5,6,7">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Image Name="bgImage" Source="Assets/nav_bkg0.jpg" Stretch="Fill"/>
                                <TextBlock Name="BackButtonTextBlock" Text="{x:Static resx:Strings.BackButton}" Foreground="Yellow" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bgImage" Property="Source" Value="Assets/nav_bkg1.jpg"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="NextButton" Width="145" Height="42" Margin="0,0,0,0" Click="NextButton_Click" local:PageProperties.PageNumbers="1,2,3,4,5,6,7">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Image Name="bgImage" Source="Assets/nav_bkg0.jpg" Stretch="Fill"/>
                                <TextBlock Name="NextButtonTextBlock" Text="{x:Static resx:Strings.NextButton}" Foreground="Yellow" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bgImage" Property="Source" Value="Assets/nav_bkg1.jpg"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
            
            <!-- 取消按钮（共享） -->
            <Button x:Name="CancelButton" Width="145" Height="42" Click="CancelButton_Click" local:PageProperties.PageNumbers="1,2,3,4,5,6,7">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Image Name="bgImage" Source="Assets/nav_bkg0.jpg" Stretch="Fill"/>
                            <TextBlock Name="ButtonTextBlock" Text="{x:Static resx:Strings.CancelButton}" Foreground="Yellow" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bgImage" Property="Source" Value="Assets/nav_bkg1.jpg"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
