<Window x:Class="RA2Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RA2Installer"
        xmlns:resx="clr-namespace:RA2Installer.Resources"
        mc:Ignorable="d"
        Title="{x:Static resx:Strings.WindowTitle}" ResizeMode="NoResize" SizeToContent="WidthAndHeight">
    <Grid Width="640" Height="480">
        <!-- 动画显示控件（共享） -->
        <Image x:Name="AnimationImage" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,75,0,0" Width="470"/>
        
        <!-- 雷达区：从Language.dll读取的文本显示区域（共享） -->
        <StackPanel x:Name="RadarTextStackPanel" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="483,39,0,0" Width="154"/>
        
        <!-- 许可证内容显示区域（第二页特有） -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="115,45,0,0" Width="245" Height="245" BorderThickness="1" BorderBrush="#BB080B" Visibility="Collapsed" x:Name="LicenseBorder">
            <ScrollViewer x:Name="LicenseScrollViewer" Width="235" Height="230" VerticalScrollBarVisibility="Auto" Padding="5">
                <TextBlock x:Name="LicenseTextBlock" Foreground="#BB080B" FontSize="12" TextWrapping="Wrap" Text="{x:Static resx:Strings.LicenseContent}"/>
            </ScrollViewer>
        </Border>
        
        <!-- 同意按钮（动画帧，第二页特有） -->
        <Image x:Name="AgreeButtonImage" Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="130,295,0,0" Width="210" Visibility="Collapsed" MouseLeftButtonUp="AgreeButtonImage_MouseLeftButtonUp"/>

        <!-- 同意条款文本（第二页特有） -->
        <TextBlock x:Name="IAgreeToTheseTermsTextBlock" Foreground="#FFEF84" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="205,300,0,0" Width="130" TextAlignment="Left" Visibility="Collapsed" Text="{x:Static resx:Strings.IAgreeToTheseTerms}"/>
        
        <!-- 底部文字显示区域（共享） -->
        <TextBlock x:Name="BottomTextBlock" Foreground="Yellow" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,160,8" TextAlignment="Center" Visibility="Collapsed"/>

        <!-- 按钮容器（共享） -->
        <StackPanel x:Name="ButtonContainer" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,29">
            <!-- 导航按钮（所有页面共用） -->
            <StackPanel x:Name="NavigationButtonsStackPanel" Orientation="Vertical">
                <Button x:Name="BackButton" Width="145" Height="42" Margin="0,0,0,0" Cursor="Hand" Click="BackButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Image Name="bgImage" Source="Assets/nav_bkg0.jpg" Stretch="Fill"/>
                                <TextBlock Name="BackButtonTextBlock" Text="{x:Static resx:Strings.BackButton}" Foreground="Yellow" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bgImage" Property="Source" Value="Assets/nav_bkg1.jpg"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="NextButton" Width="145" Height="42" Margin="0,0,0,0" Cursor="Hand" Click="NextButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Image Name="bgImage" Source="Assets/nav_bkg0.jpg" Stretch="Fill"/>
                                <TextBlock Name="NextButtonTextBlock" Text="{x:Static resx:Strings.NextButton}" Foreground="Yellow" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bgImage" Property="Source" Value="Assets/nav_bkg1.jpg"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
            
            <!-- 取消按钮（共享） -->
            <Button x:Name="CancelButton" Width="145" Height="42" Cursor="Hand" Click="CancelButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Image Name="bgImage" Source="Assets/nav_bkg0.jpg" Stretch="Fill"/>
                            <TextBlock Name="ButtonTextBlock" Text="{x:Static resx:Strings.CancelButton}" Foreground="Yellow" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bgImage" Property="Source" Value="Assets/nav_bkg1.jpg"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
