<Window x:Class="RA2Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RA2Installer"
        xmlns:resx="clr-namespace:RA2Installer.Resources"
        mc:Ignorable="d"
        Title="{x:Static resx:Strings.WindowTitle}" ResizeMode="NoResize" SizeToContent="WidthAndHeight">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BB080B"/>
            <Setter Property="Foreground" Value="#BB080B"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="border"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.56"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="Red"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Width="640" Height="480">
        <!-- 动画显示控件（共享） -->
        <Image x:Name="AnimationImage" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,75,0,0" Width="470"/>
        
        <!-- 雷达区：从Language.dll读取的文本显示区域（共享） -->
        <StackPanel x:Name="RadarTextStackPanel" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="483,39,0,0" Width="154"/>
        
        <!-- 许可证内容显示区域（第二页特有） -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="115,45,0,0" Width="245" Height="245" BorderThickness="1" BorderBrush="#BB080B" Visibility="Collapsed" x:Name="LicenseBorder">
            <ScrollViewer x:Name="LicenseScrollViewer" Width="235" Height="230" VerticalScrollBarVisibility="Auto" Padding="5">
                <TextBlock x:Name="LicenseTextBlock" Foreground="#BB080B" FontSize="12" TextWrapping="Wrap" Text="{x:Static resx:Strings.LicenseContent}"/>
            </ScrollViewer>
        </Border>
        
        <!-- 许可证内容显示区域（第三页特有，无边框） -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="115,45,0,0" Width="245" Height="245" Visibility="Collapsed" x:Name="LicenseStackPanel">
            <ScrollViewer x:Name="LicenseScrollViewerPage3" Width="235" Height="230" VerticalScrollBarVisibility="Auto" Padding="5">
                <TextBlock x:Name="LicenseTextBlockPage3" Foreground="#BB080B" FontSize="12" TextWrapping="Wrap"/>
            </ScrollViewer>
        </StackPanel>
        
        <!-- 同意按钮（动画帧，第二页特有） -->
        <Image x:Name="AgreeButtonImage" Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="130,295,0,0" Width="210" Visibility="Collapsed" MouseLeftButtonUp="AgreeButtonImage_MouseLeftButtonUp"/>

        <!-- 同意条款文本（第二页特有） -->
        <TextBlock x:Name="IAgreeToTheseTermsTextBlock" Foreground="#FFEF84" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="205,300,0,0" Width="130" TextAlignment="Left" Visibility="Collapsed" Text="{x:Static resx:Strings.IAgreeToTheseTerms}"/>
        
        <!-- 底部文字显示区域（共享） -->
        <TextBlock x:Name="BottomTextBlock" Foreground="Yellow" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,160,8" TextAlignment="Center" Visibility="Collapsed"/>
        
        <!-- 输入框区域（第三页特有） -->
        <StackPanel x:Name="InputFieldsStackPanel" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7,0,0,3" Width="457" Visibility="Collapsed">
            <TextBox x:Name="InputField1" Width="120" Height="20" Margin="0" BorderThickness="2,2,1,2" MaxLength="6" PreviewTextInput="InputField_PreviewTextInput" GotFocus="InputField_GotFocus" LostFocus="InputField_LostFocus" TextChanged="InputField_TextChanged" TabIndex="1"/>
            <TextBox x:Name="InputField2" Width="120" Height="20" Margin="0" BorderThickness="1,2,1,2" MaxLength="6" PreviewTextInput="InputField_PreviewTextInput" GotFocus="InputField_GotFocus" LostFocus="InputField_LostFocus" TextChanged="InputField_TextChanged" TabIndex="2"/>
            <TextBox x:Name="InputField3" Width="120" Height="20" Margin="0" BorderThickness="1,2,1,2" MaxLength="6" PreviewTextInput="InputField_PreviewTextInput" GotFocus="InputField_GotFocus" LostFocus="InputField_LostFocus" TextChanged="InputField_TextChanged" TabIndex="3"/>
            <TextBox x:Name="InputField4" Width="97" Height="20" Margin="0" BorderThickness="1,2,2,2" MaxLength="4" PreviewTextInput="InputField_PreviewTextInput" GotFocus="InputField_GotFocus" LostFocus="InputField_LostFocus" TextChanged="InputField_TextChanged" TabIndex="4"/>
        </StackPanel>
        
        <!-- 多选框区域（第四页特有） -->
        <StackPanel x:Name="CheckBoxesStackPanel" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,80,0,0" Visibility="Collapsed">
            <TextBlock x:Name="CheckBoxesTitleTextBlock" Foreground="Yellow" FontSize="16" Margin="0,0,0,30"/>
            <StackPanel Orientation="Horizontal" Margin="10,5,0,20" x:Name="CheckBoxItem1">
                <Image x:Name="CheckBox1" Width="18" Height="18" Cursor="Hand" MouseLeftButtonUp="CheckBox_MouseLeftButtonUp" Tag="1"/>
                <TextBlock x:Name="CheckBoxText1" Foreground="Yellow" FontSize="16" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,5,0,20" x:Name="CheckBoxItem2">
                <Image x:Name="CheckBox2" Width="18" Height="18" Cursor="Hand" MouseLeftButtonUp="CheckBox_MouseLeftButtonUp" Tag="2"/>
                <TextBlock x:Name="CheckBoxText2" Foreground="Yellow" FontSize="16" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,5,0,20" x:Name="CheckBoxItem3">
                <Image x:Name="CheckBox3" Width="18" Height="18" Cursor="Hand" MouseLeftButtonUp="CheckBox_MouseLeftButtonUp" Tag="3"/>
                <TextBlock x:Name="CheckBoxText3" Foreground="Yellow" FontSize="16" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,5,0,20" x:Name="CheckBoxItem4">
                <Image x:Name="CheckBox4" Width="18" Height="18" Cursor="Hand" MouseLeftButtonUp="CheckBox_MouseLeftButtonUp" Tag="4"/>
                <TextBlock x:Name="CheckBoxText4" Foreground="Yellow" FontSize="16" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- 按钮容器（共享） -->
        <StackPanel x:Name="ButtonContainer" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,29">
            <!-- 导航按钮（所有页面共用） -->
            <StackPanel x:Name="NavigationButtonsStackPanel" Orientation="Vertical">
                <Button x:Name="BackButton" Width="145" Height="42" Margin="0,0,0,0" Cursor="Hand" Click="BackButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Image Name="bgImage" Source="Assets/nav_bkg0.jpg" Stretch="Fill"/>
                                <TextBlock Name="BackButtonTextBlock" Text="{x:Static resx:Strings.BackButton}" Foreground="Yellow" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bgImage" Property="Source" Value="Assets/nav_bkg1.jpg"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="NextButton" Width="145" Height="42" Margin="0,0,0,0" Cursor="Hand" Click="NextButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Image Name="bgImage" Source="Assets/nav_bkg0.jpg" Stretch="Fill"/>
                                <TextBlock Name="NextButtonTextBlock" Text="{x:Static resx:Strings.NextButton}" Foreground="Yellow" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bgImage" Property="Source" Value="Assets/nav_bkg1.jpg"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
            
            <!-- 取消按钮（共享） -->
            <Button x:Name="CancelButton" Width="145" Height="42" Cursor="Hand" Click="CancelButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Image Name="bgImage" Source="Assets/nav_bkg0.jpg" Stretch="Fill"/>
                            <TextBlock Name="ButtonTextBlock" Text="{x:Static resx:Strings.CancelButton}" Foreground="Yellow" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bgImage" Property="Source" Value="Assets/nav_bkg1.jpg"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
